pipeline {
  agent any

  parameters {
    choice(name: 'TF_ACTION', choices: ['plan', 'apply', 'destroy'], description: 'Terraform action to perform')
    string(name: 'TF_VARS_FILE', defaultValue: 'variables.tfvars', description: 'Terraform variable file (e.g., dev.tfvars, prod.tfvars)')
    string(name: 'TF_BACKEND_BUCKET', defaultValue: 'my-gke-terraform-state', description: 'GCS bucket for backend')

  }

  environment {
    TF_WORKING_DIR = './gke_cluster_tf/' // Path to your Terraform code
    GOOGLE_CREDENTIALS = credentials('test') // Jenkins credential ID for GCP SA key (as Secret File)
    GOOGLE_PROJECT = 'custom-sun-468208-s1' // Optional: Replace with your actual project ID
  }

  stages {
    stage('Authenticate with GCP') {
      steps {
        script {
          echo "Authenticating to GCP..."
          withCredentials([file(credentialsId: 'test', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
            sh """
              gcloud auth activate-service-account --key-file=$GOOGLE_APPLICATION_CREDENTIALS
              gcloud config set project $GOOGLE_PROJECT
              gcloud auth application-default login --quiet < /dev/null || true
            """
          }
        }
      }
    }

    stage('Terraform Init') {
      steps {
        dir("${env.TF_WORKING_DIR}") {
          sh 'terraform init -input=false'
        }
      }
    }

    stage('Terraform Plan') {
      when {
        anyOf {
          expression { params.TF_ACTION == 'plan' }
          expression { params.TF_ACTION == 'apply' }
        }
      }
      steps {
        dir("${env.TF_WORKING_DIR}") {
          sh "terraform plan -input=false -var-file=${params.TF_VARS_FILE}"
        }
      }
    }

    stage('Terraform Apply') {
      when {
        expression { params.TF_ACTION == 'apply' }
      }
      steps {
        dir("${env.TF_WORKING_DIR}") {
          sh "terraform apply -auto-approve -input=false -var-file=${params.TF_VARS_FILE}"
        }
      }
    }

    stage('Terraform Destroy') {
      when {
        expression { params.TF_ACTION == 'destroy' }
      }
      steps {
        dir("${env.TF_WORKING_DIR}") {
          sh "terraform destroy -auto-approve -input=false -var-file=${params.TF_VARS_FILE}"
        }
      }
    }
  }

  post {
    always {
      echo 'Terraform pipeline completed.'
    }
    failure {
      echo 'Terraform pipeline failed.'
    }
  }
}
